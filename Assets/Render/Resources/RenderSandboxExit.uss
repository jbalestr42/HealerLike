/* The sandbox's Menu button, drawn like the Toolkit menu's own pill buttons (RenderSpellSpacing encounter actions). */
#sandbox-exit-overlay {
    -unity-font-definition: url("../Font/Coiny/Coiny-Regular.ttf");
}
#sandbox-exit-overlay .button {
    min-width: 88px;
    min-height: 44px;
    padding: 4px 20px;
    font-size: 13px;
    -unity-font-style: normal;
    color: rgb(248, 247, 223);
    background-color: rgba(24, 65, 55, 0.72);
    border-color: rgba(238, 239, 217, 0.65);
    border-width: 1px;
    border-radius: 16px;
    text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9);
}
#sandbox-exit-overlay .button:hover,
#sandbox-exit-overlay .button:active {
    background-color: rgba(44, 65, 58, 0.9);
    border-color: rgb(189, 218, 156);
}
