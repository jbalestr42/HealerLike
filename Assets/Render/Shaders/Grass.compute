#pragma kernel HLUpdateGrass
#include "GrassZones.hlsl"

struct HLBladeSeed
{
    float4 positionYaw;
    float4 heightWidthLean;
};

struct HLBladeState
{
    float4 leanHeightSpike;
};

StructuredBuffer<HLBladeSeed> _HL_BladeSeeds;
RWStructuredBuffer<HLBladeState> _HL_BladeStates;
AppendStructuredBuffer<uint> _HL_VisibleBlades;
uint _HL_BladeCount;
float4 _HL_FrustumPlanes[6];

// A lean is a tilt of the rigid tuft about its root, in radians, pointing where the tip goes
float2 HLCapLean(float2 lean, float limit)
{
    return lean * min(1.0, limit / max(length(lean), 1e-5));
}

HLBladeState HLEvaluateBlade(HLBladeSeed blade)
{
    float2 position = blade.positionYaw.xz;
    float heal = 0.0;
    float spike = 0.0;
    float bruise = 0.0;
    float spikeHeight = 0.0;
    float spikePresence = 0.0;
    float weightSum = 0.0;
    float ringClear = 0.0;
    float trample = 0.0;
    float2 launch = 0.0;
    float2 outwardSum = 0.0;
    float2 yaw = float2(cos(blade.positionYaw.w), sin(blade.positionYaw.w));

    for (int i = 0; i < min(_HL_ZoneCount, 64); i++)
    {
        HLZone zone = HLLoadZone(i);
        float weight = HLGrassZoneWeight(zone, position);
        if (zone.kind == 2)
        {
            spike = max(spike, weight);
            // Presence keeps the same spike geometry during both emergence and sinking
            if (weight > 0.0)
            {
                spikePresence = 1.0;
            }

            spikeHeight = max(spikeHeight, weight * smoothstep(0.0, 0.15, zone.age));
        }

        if (zone.kind == 6)
        {
            // Smooth irregular flattening, rather than a shaved disc with a hard circular rim
            float2 delta = position - zone.position.xz;
            float radius = zone.radius * (0.88 + 0.12 * sin(dot(position, float2(9.7, 6.3))));
            float footprint = HLGrassZoneOnset(zone) * (1.0 - smoothstep(radius * 0.35, radius, length(delta)));
            trample = max(trample, footprint);
        }

        if (zone.kind == 4)
        {
            bruise = max(bruise, weight);
        }

        if (zone.kind == 5 && zone.radius > 0.0)
        {
            float2 delta = position - zone.position.xz;
            float front = zone.radius * saturate(zone.age / 0.4);
            float band = max(0.15, zone.radius * 0.12);
            float wave = (1.0 - smoothstep(0.0, band, abs(length(delta) - front))) * weight;
            launch += zone.direction * wave * saturate(dot(delta / max(length(delta), 1e-5), zone.direction));
        }

        if ((zone.kind != 1 && zone.kind != 3) || zone.radius <= 0.0)
        {
            continue;
        }

        heal = max(heal, weight * (zone.kind == 3 ? 0.35 : 1.0));
        float2 offset = position - zone.position.xz;
        float distanceToZone = length(offset);
        outwardSum += weight * (distanceToZone < 1e-5 ? yaw : offset / distanceToZone);
        weightSum += weight;
        float inner = min(0.06, zone.radius * 0.08);
        float outer = min(0.22, zone.radius * 0.25);
        float edge = 1.0 - smoothstep(inner, outer, abs(distanceToZone - zone.radius));
        ringClear = max(ringClear, HLGrassZoneOnset(zone) * edge);
    }

    HLBladeState state;
    float height = blade.heightWidthLean.x;
    float spikeRandom = frac(sin(dot(position, float2(12.9898, 78.233))) * 43758.5453);
    if (spikePresence > 0.0 && trample < 0.5)
    {
        // Spikes keep their own world height, 0.26 to 0.63 by a hash of the root, whatever the tuft height
        float2 spikeLean = yaw * (0.10 * spikeRandom);
        float spikeTall = spikeHeight * (0.26 + 0.37 * spikeRandom);
        state.leanHeightSpike = float4(spikeLean, max(0.001, spikeTall / height), max(0.5, spike));
        return state;
    }

    float2 outward = outwardSum / max(1.0, weightSum);
    // Each tuft keeps its own fixed rest tilt; zones push on top of it, up to 20 degrees more, 40 out of a heal
    float2 zoneLean = HLCapLean(0.55 * outward + 0.45 * launch, 0.35 + 0.35 * heal);
    float2 lean = (blade.heightWidthLean.zw + zoneLean) * (1.0 - 2.0 * spike);
    float scale = lerp((1.0 + 0.8 * heal) * (1.0 - 0.65 * bruise), 0.005 / height, ringClear);
    scale = lerp(scale, 0.055 / height, trample);
    lean = lerp(lean, yaw * 0.5, trample);
    spike *= 1.0 - trample;

    // Flatten the edge band as a whole, including sideways displacement
    state.leanHeightSpike = float4(lean * (1.0 - ringClear), scale, spike);
    return state;
}

[numthreads(64, 1, 1)]
void HLUpdateGrass(uint3 dispatchID : SV_DispatchThreadID)
{
    uint index = dispatchID.x;
    if (index >= _HL_BladeCount)
    {
        return;
    }

    HLBladeSeed blade = _HL_BladeSeeds[index];
    for (int plane = 0; plane < 6; plane++)
    {
        if (dot(_HL_FrustumPlanes[plane].xyz, blade.positionYaw.xyz) + _HL_FrustumPlanes[plane].w < -0.85)
        {
            return;
        }
    }

    _HL_BladeStates[index] = HLEvaluateBlade(blade);
    _HL_VisibleBlades.Append(index);
}
