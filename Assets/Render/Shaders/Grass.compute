#pragma kernel HLUpdateGrass
#include "GrassZones.hlsl"
#include "GrassTuftData.hlsl"
#include "GroundCommon.hlsl"

// Hostile spikes: they rise over this many seconds, stand 0.26 to 0.63 world units tall by a hash of the root,
// GrassLayout.SpikeHeight on the C# side, and lean at most this far along their yaw
#define HL_SPIKE_RISE_SECONDS 0.15
#define HL_SPIKE_MIN_HEIGHT 0.26
#define HL_SPIKE_HEIGHT_RANGE 0.37
#define HL_SPIKE_LEAN 0.10
// A spike under this much flattening gives way to the flattened tuft
#define HL_SPIKE_TRAMPLE_LIMIT 0.5
// Flattened tufts fold down to this lean along their push and shrink to this world height
#define HL_CRUSH_LEAN 1.2
#define HL_CRUSH_HEIGHT 0.14
// A range preview lifts the grass by this share of a heal
#define HL_RANGE_HEAL 0.35
// Heal lifts a tuft by this share of its height, GrassLayout.HealLift minus one; bruise sinks it by this share
#define HL_HEAL_LIFT 0.8
#define HL_BRUISE_SINK 0.65
// The ring clears a band around the heal edge, from the inner to the outer width, capped for large zones
#define HL_RING_INNER 0.06
#define HL_RING_INNER_SHARE 0.08
#define HL_RING_OUTER 0.22
#define HL_RING_OUTER_SHARE 0.25
#define HL_RING_CLEAR_HEIGHT 0.005
// Each tuft answers the ground's lean by a share drawn from its root, so neighbours never sway in lockstep
#define HL_RESPONSE_MIN 0.75
#define HL_RESPONSE_RANGE 0.5
// A moving lean shivers the tuft by this share of its speed, at this rate
#define HL_SHIVER 0.02
#define HL_SHIVER_RATE 13.0
// The ground's own lean fades into the plain wind over this many world units before its edge
#define HL_GROUND_FADE 1.0

StructuredBuffer<HLTuftSeed> _HLBladeSeeds;
RWStructuredBuffer<HLTuftState> _HLBladeStates;
AppendStructuredBuffer<uint> _HLVisibleBlades;
uint _HLBladeCount;
float4 _HLFrustumPlanes[6];
// How far outside a frustum plane a root may sit and still draw, GrassBounds.Envelope
float _HLCullMargin;
// GroundWind.Shader, and the gust pulses' lean
float4 _HLGroundWind;
float2 _HLGroundGust;
// The ground GroundMotion publishes: xy lean and zw its velocity, the flatness, where it lies, and one while live
Texture2D<float4> _HLGroundMotion;
Texture2D<float> _HLGroundCrush;
SamplerState hl_linear_clamp_sampler;
float4 _HLGroundRect;
float _HLGroundActive;

// A lean is the tilt of the chord from a tuft's root to its tip, in radians, pointing where the tip goes
HLTuftState HLEvaluateTuft(HLTuftSeed tuft)
{
    float2 position = tuft.positionYaw.xz;
    float heal = 0.0;
    float spike = 0.0;
    float bruise = 0.0;
    float spikeHeight = 0.0;
    float spikePresence = 0.0;
    float ringClear = 0.0;
    float2 yaw = float2(cos(tuft.positionYaw.w), sin(tuft.positionYaw.w));

    for (int i = 0; i < min(_HLZoneCount, HL_MAX_ZONES); i++)
    {
        HLZone zone = HLLoadZone(i);
        float weight = HLGrassZoneWeight(zone, position);
        if (zone.kind == HL_ZONE_HOSTILE)
        {
            spike = max(spike, weight);
            // Presence keeps the same spike geometry during both emergence and sinking
            if (weight > 0.0)
            {
                spikePresence = 1.0;
            }

            spikeHeight = max(spikeHeight, weight * smoothstep(0.0, HL_SPIKE_RISE_SECONDS, zone.age));
        }

        if (zone.kind == HL_ZONE_BRUISE)
        {
            bruise = max(bruise, weight);
        }

        if ((zone.kind != HL_ZONE_HEAL && zone.kind != HL_ZONE_RANGE) || zone.radius <= 0.0)
        {
            continue;
        }

        heal = max(heal, weight * (zone.kind == HL_ZONE_RANGE ? HL_RANGE_HEAL : 1.0));
        float distanceToZone = length(position - zone.position.xz);
        float inner = min(HL_RING_INNER, zone.radius * HL_RING_INNER_SHARE);
        float outer = min(HL_RING_OUTER, zone.radius * HL_RING_OUTER_SHARE);
        float edge = 1.0 - smoothstep(inner, outer, abs(distanceToZone - zone.radius));
        ringClear = max(ringClear, HLGrassZoneOnset(zone) * edge);
    }

    // The ground's springy lean and flatness at the root, easing into the plain wind outside it
    float2 uv = HLGroundUV(position, _HLGroundRect);
    float coverage = _HLGroundActive > 0.5 ? HLGroundCoverage(uv, _HLGroundRect, HL_GROUND_FADE) : 0.0;
    float4 motion = float4(0.0, 0.0, 0.0, 0.0);
    float crush = 0.0;
    if (coverage > 0.0)
    {
        motion = _HLGroundMotion.SampleLevel(hl_linear_clamp_sampler, uv, 0.0);
        crush = saturate(_HLGroundCrush.SampleLevel(hl_linear_clamp_sampler, uv, 0.0)) * coverage;
    }

    float2 wind = HLGroundWindLean(position, _HLGroundWind, _HLGroundGust);
    float2 ground = lerp(wind, motion.xy, coverage);

    HLTuftState state;
    float height = tuft.heightWidthLean.x;
    float spikeRandom = frac(sin(dot(position, float2(12.9898, 78.233))) * 43758.5453);
    if (spikePresence > 0.0 && crush < HL_SPIKE_TRAMPLE_LIMIT)
    {
        // Spikes keep their own world height, whatever the tuft height
        float2 spikeLean = yaw * (HL_SPIKE_LEAN * spikeRandom);
        float spikeTall = spikeHeight * (HL_SPIKE_MIN_HEIGHT + HL_SPIKE_HEIGHT_RANGE * spikeRandom);
        state.leanHeightSpike = float4(spikeLean, max(0.001, spikeTall / height), max(0.5, spike));
        return state;
    }

    float response = HL_RESPONSE_MIN + HL_RESPONSE_RANGE * frac(spikeRandom * 7.31);
    float shiver = HL_SHIVER * sin(_HLGroundWind.w * HL_SHIVER_RATE + spikeRandom * 6.2831853);
    float2 lean = tuft.heightWidthLean.zw + response * ground + shiver * motion.zw * coverage;
    // Flattened tufts fold down along their push and shrink toward the ground
    float2 fold = length(ground) > 1e-3 ? normalize(ground) : yaw;
    lean = lerp(lean, fold * HL_CRUSH_LEAN, crush);
    float grown = (1.0 + HL_HEAL_LIFT * heal) * (1.0 - HL_BRUISE_SINK * bruise);
    float scale = lerp(grown, HL_RING_CLEAR_HEIGHT / height, ringClear);
    scale = lerp(scale, min(scale, HL_CRUSH_HEIGHT / height), crush);
    spike *= 1.0 - crush;

    // Flatten the edge band as a whole, including sideways displacement
    state.leanHeightSpike = float4(lean * (1.0 - ringClear), scale, spike);
    return state;
}

[numthreads(64, 1, 1)]
void HLUpdateGrass(uint3 dispatchID : SV_DispatchThreadID)
{
    uint index = dispatchID.x;
    if (index >= _HLBladeCount)
    {
        return;
    }

    HLTuftSeed tuft = _HLBladeSeeds[index];
    for (int plane = 0; plane < 6; plane++)
    {
        if (dot(_HLFrustumPlanes[plane].xyz, tuft.positionYaw.xyz) + _HLFrustumPlanes[plane].w < -_HLCullMargin)
        {
            return;
        }
    }

    _HLBladeStates[index] = HLEvaluateTuft(tuft);
    _HLVisibleBlades.Append(index);
}
