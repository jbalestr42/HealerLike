#pragma kernel HLUpdateGrass
#include "HLGrassZones.hlsl"
struct HLBladeSeed { float4 positionYaw; float4 heightPhaseWidthRandom; };
struct HLBladeState { float4 leanHeightSpike; float4 rampHealReserved; };
StructuredBuffer<HLBladeSeed> _HL_BladeSeeds;
RWStructuredBuffer<HLBladeState> _HL_BladeStates;
AppendStructuredBuffer<uint> _HL_VisibleGrass;
AppendStructuredBuffer<uint> _HL_VisibleCones;
uint _HL_BladeCount;
float4 _HL_FrustumPlanes[6];
float _HL_Time;
float4 _HL_Wind;
float2 HLCapLean(float2 v, float limit) { return v * min(1, limit / max(length(v), 1e-5)); }
float2 HLWindFlow(float2 p, float phase, float timeSeconds)
{
    float2 D = _HL_Wind.xy, P = float2(-D.y, D.x);
    float q = dot(p, D) - _HL_Wind.z * timeSeconds;
    float gust = 0.65 + 0.25 * sin(6.2831853 * q / 3.5)
        + 0.10 * sin(6.2831853 * (q / 1.3 + dot(p, P) / 5));
    return HLCapLean(D * (_HL_Wind.w * gust)
        + P * (_HL_Wind.w * (0.012 / 0.065) * sin(6.2831853 * q / 2.2 + phase)), max(0.10, _HL_Wind.w * (0.10 / 0.065)));
}
HLBladeState HLEvaluateBlade(HLBladeSeed blade)
{
    float2 p = blade.positionYaw.xz;
    float h = 0, s = 0, bruise = 0, coneHeight = 0, conePresence = 0, weightSum = 0, ringClear = 0;
    float2 launch = 0;
    float2 outwardSum = 0;
    float2 yaw = float2(cos(blade.positionYaw.w), sin(blade.positionYaw.w));
    for (int j = 0; j < min(_HL_ZoneCount, 64); j++)
    {
        HLZone z = HLLoadZone(j);
        float w = HLGrassZoneWeight(z, p);
        if (z.kind == 2)
        {
            s = max(s, w);
            // Presence keeps the same cone geometry during both emergence and sinking.
            if (w > 0) conePresence = 1;
            coneHeight = max(coneHeight, w * smoothstep(0, 0.15, z.age));
        }
        if (z.kind == 4) bruise = max(bruise, w);
        if (z.kind == 5 && z.radius > 0)
        {
            float2 delta = p - z.position.xz;
            float front = z.radius * saturate(z.age / 0.4);
            float band = max(0.15, z.radius * 0.12);
            float wave = (1 - smoothstep(0, band, abs(length(delta) - front))) * w;
            launch += z.direction * wave * saturate(dot(delta / max(length(delta), 1e-5), z.direction));
        }
        if ((z.kind != 1 && z.kind != 3) || z.radius <= 0) continue;
        h = max(h, w * (z.kind == 3 ? 0.35 : 1));
        float2 delta = p - z.position.xz;
        float d = length(delta);
        outwardSum += w * (d < 1e-5 ? yaw : delta / d);
        weightSum += w;
        ringClear = max(ringClear, HLGrassZoneOnset(z) * (1 - smoothstep(0.06, 0.10, abs(d - z.radius))));
    }
    HLBladeState state;
    if (conePresence > 0)
    {
        state.leanHeightSpike = float4(yaw * (0.04 * blade.heightPhaseWidthRandom.w), max(0.001, 1.5 * coneHeight), max(0.5, s));
        state.rampHealReserved = float4(2, 0, 0, 0);
    }
    else
    {
        float2 outward = outwardSum / max(1, weightSum);
        float2 lean = HLCapLean(HLWindFlow(p, blade.heightPhaseWidthRandom.y, _HL_Time) * (1 - 0.65 * h)
            + 0.20 * outward + 0.22 * launch, 0.36) * (1 - 2 * s);
        float scale = lerp((1 + 0.8 * h) * (1 - 0.65 * bruise), 0.005 / blade.heightPhaseWidthRandom.x, ringClear);
        // Flatten the edge band as a whole, including sideways displacement.
        state.leanHeightSpike = float4(lean * (1 - ringClear), scale, s);
        state.rampHealReserved = float4(h > 0 ? 1 : 0, h, bruise, 0);
    }
    return state;
}
[numthreads(64, 1, 1)]
void HLUpdateGrass(uint3 dispatchID : SV_DispatchThreadID)
{
    uint i = dispatchID.x;
    if (i >= _HL_BladeCount) return;
    HLBladeSeed blade = _HL_BladeSeeds[i];
    HLBladeState state = HLEvaluateBlade(blade);
    _HL_BladeStates[i] = state;
    for (int plane = 0; plane < 6; plane++)
        if (dot(_HL_FrustumPlanes[plane].xyz, blade.positionYaw.xyz) + _HL_FrustumPlanes[plane].w < -0.85) return;
    if (state.leanHeightSpike.w >= 0.5) _HL_VisibleCones.Append(i);
    else _HL_VisibleGrass.Append(i);
}
