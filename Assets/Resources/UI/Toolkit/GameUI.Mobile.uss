/* Touch layouts use the same controls and game actions as the desktop HUD. */
.is-mobile .brand-block { display: none; }
.is-mobile .mobile-only { display: flex; }
.is-mobile .top-bar { min-height: 62px; padding: 6px 8px; }
.is-mobile .run-status { flex-shrink: 1; min-width: 0; }
.is-mobile .heading { font-size: 17px; }
.is-mobile .run-status .muted { font-size: 10px; }
.is-mobile .currency { font-size: 12px; margin-right: 5px; }
.is-mobile .button { min-width: 44px; min-height: 44px; padding: 6px 10px; font-size: 13px; }
.is-mobile .header-actions .button { margin-left: 4px; padding-left: 8px; padding-right: 8px; }
.is-mobile .field-toolbar { height: 44px; margin-top: 6px; }
.is-mobile .field-toolbar > .button { margin-left: 0; margin-right: 6px; }
.is-mobile .field-toolbar > #focus-button { margin-right: 0; }
.is-mobile .main-content { min-height: 0; margin-top: 6px; margin-bottom: 6px; }
.is-mobile .world-space { min-width: 0; }
.is-mobile .party-panel, .is-mobile .detail-panel { position: absolute; left: 0; top: 0; bottom: 0; right: 0; width: auto; max-height: 100%; padding: 12px; display: none; }
.is-mobile.party-open .party-panel, .is-mobile.detail-open .detail-panel { display: flex; }
.is-mobile .detail-panel { align-self: stretch; }
.is-mobile .drawer-header { flex-shrink: 0; margin-bottom: 8px; }
.is-mobile .drawer-header .section-heading { margin-bottom: 0; }
.is-mobile .party-list, .is-mobile .detail-scroll { min-height: 0; flex-grow: 1; flex-shrink: 1; }
.is-mobile .section-description { margin-bottom: 8px; }
.is-mobile .detail-icon { width: 56px; height: 56px; margin-top: 0; }
.is-mobile .detail-description { font-size: 14px; }
.is-mobile .command-dock { min-height: 0; max-height: none; flex-direction: column; padding: 8px; }
.is-mobile .section-toolbar { margin-bottom: 4px; height: 18px; }
.is-mobile .mana-bar { width: 160px; }
.is-mobile .spell-list { height: 106px; flex-grow: 0; flex-shrink: 0; }
.is-mobile .spell-list .card-shell { width: 112px; height: 102px; margin-right: 6px; }
.is-mobile .spell-list .data-card { width: 100%; height: 102px; min-height: 0; padding: 7px; }
.is-mobile .spell-list .data-card__icon { width: 30px; height: 30px; margin-bottom: 3px; }
.is-mobile .spell-list .data-card__title { font-size: 12px; height: 29px; margin-bottom: 0; overflow: hidden; }
.is-mobile .spell-list .data-card__status { font-size: 11px; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.is-mobile .card-info { display: flex; position: absolute; right: 0; top: 0; width: 44px; height: 44px; margin: 0; padding: 0; font-size: 11px; border-top-left-radius: 0; border-bottom-right-radius: 0; }
.is-mobile .party-list .data-card { padding-right: 52px; min-height: 108px; }
.is-mobile .command-section { width: auto; margin-left: 0; margin-top: 4px; }
.is-mobile .status-label { font-size: 11px; margin-bottom: 4px; }
.is-mobile .encounter-actions { flex-shrink: 0; }
.is-mobile .speed-controls { margin-top: 0; margin-bottom: 12px; }
.is-mobile .speed-controls .button { min-width: 56px; }
.is-mobile .marker-toggle { min-height: 44px; align-items: center; margin-bottom: 12px; font-size: 13px; }
.is-mobile .marker-toggle .unity-toggle__input { min-width: 44px; min-height: 44px; }
.is-mobile .modal-layer { padding: 0; }
.is-mobile .dialog { padding: 16px; max-height: 100%; min-height: 0; }
.is-mobile .dialog--wide { width: 100%; height: 100%; }
.is-mobile .dialog--compact { width: 100%; }
.is-mobile .dialog-title { font-size: 25px; margin-bottom: 8px; }
.is-mobile .dialog-description { margin-bottom: 12px; font-size: 13px; }
.is-mobile .collection-list { min-height: 0; flex-shrink: 1; }
.is-mobile #inventory-list { min-height: 180px; flex-shrink: 0; }
.is-mobile .collection-list .unity-scroll-view__content-container { flex-direction: column; flex-wrap: nowrap; }
.is-mobile .collection-list .card-shell { width: 100%; margin-right: 0; margin-bottom: 8px; }
.is-mobile .collection-list .data-card { width: 100%; min-height: 112px; margin: 0; }
.is-mobile .collection-list .data-card__description { font-size: 13px; }
.is-mobile .inventory-action-row { flex-direction: column; align-items: stretch; }
.is-mobile .inventory-target, .is-mobile .inventory-slot { width: auto; margin: 0 0 8px 0; }
.is-mobile .inventory-actions { margin-bottom: 12px; }
.is-mobile .inventory-action-row > .button { margin-left: 0; }
.is-mobile .unity-base-popup-field__input { min-height: 44px; }
.is-mobile .detail-targeting { min-height: 64px; }
.is-mobile .action-button { min-height: 44px; font-size: 13px; }
.is-mobile .menu-panel { width: 100%; max-width: 100%; margin-top: 12px; padding: 20px; }
.is-mobile .menu-title { font-size: 32px; }
.is-mobile .menu-description { font-size: 15px; }
.is-mobile.is-menu .command-dock { min-height: 0; align-items: stretch; }
.is-mobile.is-menu .command-section { width: auto; margin-left: 0; }
.is-mobile.is-menu .field-toolbar { display: none; }
/* Short landscape keeps spells beside the encounter action so the board retains its height. */
.is-mobile.is-landscape .top-bar { min-height: 52px; }
.is-mobile.is-landscape .field-toolbar { position: absolute; top: 62px; left: 8px; right: 8px; }
.is-mobile.is-landscape .main-content { margin-top: 52px; }
.is-mobile.is-landscape .command-dock { flex-direction: row; }
.is-mobile.is-landscape .command-section { width: 180px; margin-left: 10px; margin-top: 0; }
.is-mobile.is-landscape .spell-list { height: 86px; }
.is-mobile.is-landscape .spell-list .card-shell, .is-mobile.is-landscape .spell-list .data-card { height: 82px; }
.is-mobile.is-landscape .spell-list .data-card__icon { display: none; }
.is-mobile.is-landscape .spell-list .data-card__title { margin-top: 0; padding-right: 36px; height: 38px; }
.is-mobile.is-landscape .menu-panel { margin-top: 0; padding: 12px; }
.is-mobile.is-landscape .menu-title { margin-top: 6px; margin-bottom: 6px; font-size: 25px; }
.is-mobile.is-landscape .menu-description, .is-mobile.is-landscape .menu-hint { display: none; }

.is-mobile .card-info.is-hidden { display: none; }
.menu-button { margin-top: 8px; }
/* Popup menus attach outside hud-root in Unity's runtime panel. */
.unity-base-dropdown__item { min-height: 44px; }
.unity-base-dropdown__label { min-height: 44px; -unity-text-align: middle-left; }
