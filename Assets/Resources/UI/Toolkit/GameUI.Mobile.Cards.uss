.layout--phone .party-list,
.layout--phone .detail-scroll
{
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.layout--phone .spell-list
{
    height: var(--ui-spell-mobile-list-height);
    flex-grow: 0;
    flex-shrink: 0;
}

.layout--phone .spell-list .card-shell
{
    width: var(--ui-spell-mobile-width);
    height: var(--ui-spell-mobile-height);
    margin-right: var(--ui-space-sm);
}

.layout--phone .spell-list .data-card
{
    width: 100%;
    height: var(--ui-spell-mobile-height);
    min-height: 0;
    padding: var(--ui-spell-mobile-padding);
}

.layout--phone .spell-list .data-card__icon
{
    width: var(--ui-spell-mobile-icon-size);
    height: var(--ui-spell-mobile-icon-size);
    margin-bottom: var(--ui-small-control-padding);
}

.layout--phone .spell-list .data-card__title
{
    font-size: var(--ui-text-small);
    height: var(--ui-spell-mobile-title-height);
    margin-bottom: 0;
    overflow: hidden;
}

.layout--phone .spell-list .data-card__status
{
    font-size: var(--ui-text-caption);
    height: var(--ui-small-control-height);
    flex-shrink: 0;
    margin-top: var(--ui-space-xxs);
    white-space: normal;
}

.layout--phone .card-info
{
    display: flex;
    position: absolute;
    right: 0;
    top: 0;
    width: var(--ui-touch-target);
    height: var(--ui-touch-target);
    margin: 0;
    padding: 0;
    font-size: var(--ui-text-caption);
    border-top-left-radius: 0;
    border-bottom-right-radius: 0;
}

.layout--phone .party-list .data-card
{
    padding-right: var(--ui-card-info-inset);
    min-height: var(--ui-party-mobile-card-height);
}

.layout--phone .party-list .data-card.creature-card
{
    min-height: var(--ui-party-mobile-portrait-height);
    padding: var(--ui-space-lg) var(--ui-card-info-inset) var(--ui-space-lg) var(--ui-card-portrait-inset);
    align-items: stretch;
}

.layout--phone .party-list .creature-card .data-card__icon
{
    position: absolute;
    left: var(--ui-portrait-inset);
    top: var(--ui-portrait-inset);
    width: var(--ui-portrait-size);
    height: var(--ui-portrait-size);
    margin-bottom: 0;
}

.layout--phone .collection-list .card-shell
{
    width: 100%;
    margin-right: 0;
    margin-bottom: var(--ui-space-md);
}

.layout--phone .collection-list .data-card
{
    width: 100%;
    min-height: var(--ui-item-mobile-height);
    margin: 0;
}

.layout--phone .collection-list .data-card__description
{
    font-size: var(--ui-text-control);
}

.layout--phone .card-info.is-hidden
{
    display: none;
}
