<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="DialogFrame" src="../Controls/DialogFrame.uxml" />
    <ui:Instance template="DialogFrame" class="dialog dialog--wide surface">
        <ui:Label text="AN ENCOUNTER" class="eyebrow" />
        <ui:Label name="event-title" text="Choose" class="dialog-title" />
        <ui:Label name="event-description" class="muted dialog-description is-hidden" />
        <ui:ScrollView name="event-list" class="collection-list choice-list" horizontal-scroller-visibility="Hidden" />
    </ui:Instance>
</ui:UXML>
