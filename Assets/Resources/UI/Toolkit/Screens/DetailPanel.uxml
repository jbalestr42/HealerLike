<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="SectionHeading" src="../Controls/SectionHeading.uxml" />
    <ui:Template name="ActionSection" src="../Controls/ActionSection.uxml" />
    <ui:Instance template="SectionHeading" class="drawer-header">
        <ui:AttributeOverrides element-name="section-label" text="FIELD NOTES" />
        <ui:Button name="detail-close-button" text="Close" class="button mobile-only" />
    </ui:Instance>
    <ui:ScrollView name="detail-scroll" class="detail-scroll" horizontal-scroller-visibility="Hidden">
        <ui:VisualElement name="detail-icon" class="detail-icon" />
        <ui:Label name="detail-title" text="Ready when you are" class="heading detail-title" />
        <ui:Label name="detail-description" text="Use a card’s Info button or select an ally to see its details." class="detail-description muted" />
        <ui:Instance template="ActionSection" name="detail-actions" class="detail-actions">
            <ui:DropdownField name="detail-targeting" label="Target priority" class="detail-targeting" />
            <ui:Button name="detail-equip-button" text="Select equipment" class="button" />
        </ui:Instance>
    </ui:ScrollView>
</ui:UXML>
