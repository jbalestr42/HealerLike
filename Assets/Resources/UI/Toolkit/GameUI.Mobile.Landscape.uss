.layout--phone.layout--landscape .top-bar
{
    min-height: var(--ui-header-landscape-height);
}

.layout--phone.layout--landscape .command-dock
{
    flex-direction: row;
}

.layout--phone.layout--landscape .command-section
{
    width: var(--ui-command-landscape-width);
    margin-left: var(--ui-compact-gap);
    margin-top: 0;
}

.layout--phone.layout--landscape .spell-list
{
    height: var(--ui-spell-landscape-list-height);
}

.layout--phone.layout--landscape .spell-list .card-shell,
.layout--phone.layout--landscape .spell-list .data-card
{
    height: var(--ui-spell-landscape-height);
}

.layout--phone.layout--landscape .spell-list .data-card__icon
{
    display: none;
}

.layout--phone.layout--landscape .spell-list .data-card__title
{
    margin-top: 0;
    padding-right: var(--ui-menu-padding);
    height: var(--ui-spell-landscape-title-height);
}

.layout--phone.layout--landscape .menu-panel
{
    margin-top: 0;
    padding: var(--ui-space-lg);
}

.layout--phone.layout--landscape .menu-title
{
    margin-top: var(--ui-space-sm);
    margin-bottom: var(--ui-space-sm);
    font-size: var(--ui-text-mobile-title);
}

.layout--phone.layout--landscape .menu-description,
.layout--phone.layout--landscape .menu-hint
{
    display: none;
}

.layout--phone.layout--landscape .party-panel,
.layout--phone.layout--landscape .detail-panel
{
    top: var(--ui-drawer-landscape-top);
    max-height: none;
    padding: var(--ui-space-md);
}

.layout--phone.layout--landscape .party-panel .section-description
{
    display: none;
}

.layout--phone.layout--landscape .party-list .data-card
{
    min-height: var(--ui-party-landscape-height);
    padding: var(--ui-space-md) var(--ui-card-landscape-info-inset) var(--ui-space-md) var(--ui-space-md);
}

.layout--phone.layout--landscape .party-list .data-card.creature-card
{
    min-height: var(--ui-party-landscape-portrait-height);
    padding: var(--ui-space-md) var(--ui-card-landscape-info-inset) var(--ui-space-md) var(--ui-card-landscape-portrait-inset);
}

.layout--phone.layout--landscape .party-list .creature-card .data-card__description
{
    display: none;
}

.layout--phone.layout--landscape .party-list .creature-card .data-card__title,
.layout--phone.layout--landscape .party-list .creature-card .data-card__status
{
    margin: 0;
    padding: 0;
}

.layout--phone.layout--landscape .party-list .creature-card .data-card__status
{
    margin-top: var(--ui-space-xs);
}

.layout--phone.layout--landscape .party-list .data-card__icon,
.layout--phone.layout--landscape .detail-icon
{
    display: none;
}

.layout--phone.layout--landscape .party-list .creature-card .data-card__icon.creature-portrait
{
    display: flex;
    left: var(--ui-portrait-landscape-inset);
    top: var(--ui-portrait-landscape-inset);
    width: var(--ui-portrait-compact-size);
    height: var(--ui-portrait-compact-size);
}

.layout--phone.layout--landscape .detail-icon.creature-portrait
{
    display: flex;
    width: var(--ui-portrait-size);
    height: var(--ui-portrait-size);
}

.layout--phone.layout--landscape .party-list .data-card__description
{
    font-size: var(--ui-text-small);
}

.layout--phone.layout--landscape .dialog--compact
{
    padding: var(--ui-space-lg);
}

.layout--phone.layout--landscape .dialog--compact .dialog-title
{
    font-size: var(--ui-text-landscape-title);
    margin-top: var(--ui-space-xxs);
    margin-bottom: var(--ui-space-xs);
}

.layout--phone.layout--landscape .dialog--compact .dialog-description
{
    margin-bottom: var(--ui-space-md);
}

.layout--phone.layout--landscape .pause-settings
{
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ui-space-lg);
}

.layout--phone.layout--landscape .pause-settings .speed-controls
{
    width: 50%;
    margin-bottom: 0;
}

.layout--phone.layout--landscape .pause-settings .marker-toggle
{
    margin: 0 0 0 var(--ui-panel-inline-padding);
}

.layout--phone.layout--landscape .detail-summary
{
    flex-direction: row;
    align-items: flex-start;
}

.layout--phone.layout--landscape .detail-copy
{
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.layout--phone.layout--landscape .detail-summary .detail-icon
{
    margin: 0 var(--ui-space-lg) 0 0;
}
