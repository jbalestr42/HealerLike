.layout--phone .modal-layer
{
    padding: 0;
}

.layout--phone .dialog
{
    padding: var(--ui-space-xl);
    max-height: 100%;
    min-height: 0;
}

.layout--phone .dialog--wide
{
    width: 100%;
    height: 100%;
}

.layout--phone .dialog--compact
{
    width: 100%;
}

.layout--phone .dialog-title
{
    font-size: var(--ui-text-mobile-title);
    margin-bottom: var(--ui-space-md);
}

.layout--phone .dialog-description
{
    margin-bottom: var(--ui-space-lg);
    font-size: var(--ui-text-control);
}

.layout--phone .collection-list
{
    min-height: 0;
    flex-shrink: 1;
}

.layout--phone #inventory-list
{
    min-height: var(--ui-inventory-mobile-min-height);
    flex-shrink: 0;
}

.layout--phone .collection-list .unity-scroll-view__content-container
{
    flex-direction: column;
    flex-wrap: nowrap;
}

.layout--phone .inventory-action-row
{
    flex-direction: column;
    align-items: stretch;
}

.layout--phone .inventory-target,
.layout--phone .inventory-slot
{
    width: auto;
    margin: 0 0 var(--ui-space-md) 0;
}

.layout--phone .inventory-actions
{
    margin-bottom: var(--ui-space-lg);
}

.layout--phone .inventory-action-row > .button
{
    margin-left: 0;
}

.layout--phone .unity-base-popup-field__input
{
    min-height: var(--ui-touch-target);
}

.layout--phone .detail-targeting
{
    min-height: var(--ui-targeting-mobile-height);
}

.layout--phone .action-button
{
    min-height: var(--ui-touch-target);
    font-size: var(--ui-text-control);
}

.layout--phone .menu-panel
{
    width: 100%;
    max-width: 100%;
    margin-top: var(--ui-space-lg);
    padding: var(--ui-panel-inline-padding);
}

.layout--phone .menu-title
{
    font-size: var(--ui-text-mobile-display);
}

.layout--phone .menu-description
{
    font-size: var(--ui-text-mobile-body);
}

.menu-button
{
    margin-top: var(--ui-space-md);
}

.unity-base-dropdown__item
{
    min-height: var(--ui-touch-target);
}

.unity-base-dropdown__label
{
    min-height: var(--ui-touch-target);
    -unity-text-align: middle-left;
}

.layout--phone .party-panel,
.layout--phone .detail-panel,
.layout--phone .dialog
{
    background-color: var(--ui-panel-solid);
}

.layout--phone .unity-base-popup-field__arrow
{
    -unity-background-image-tint-color: var(--ui-accent);
    opacity: 1;
}

.layout--phone .sheet-text
{
    font-size: var(--ui-text-mobile-body);
}
