/* Map geometry is authored in ToolkitRunMapPresentation; art direction stays here. */
.map-layer { padding: 12px; }
.map-dialog { width: 960px; height: 100%; max-height: 100%; min-height: 0; padding: 24px; }
.map-header { flex-shrink: 0; }
.map-heading { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.map-header .dialog-title { margin-bottom: 4px; }
.map-description { white-space: normal; margin-bottom: 16px; flex-shrink: 0; }
.map-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: rgb(12, 23, 25); border-radius: 6px; border-width: 1px; border-color: rgb(38, 58, 54); }
.map-canvas { position: relative; flex-shrink: 0; }
.map-footer { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; padding-top: 12px; }
.map-legend { flex-direction: row; flex-shrink: 1; align-items: center; }
.map-key { font-size: 10px; letter-spacing: 0.4px; margin-right: 12px; border-bottom-width: 2px; padding-bottom: 3px; }
.map-key--available { color: var(--ui-accent); border-bottom-color: var(--ui-accent); }
.map-key--current { color: var(--ui-gold); border-bottom-color: var(--ui-gold); }
.map-key--visited { color: var(--ui-muted); border-bottom-color: rgb(108, 105, 74); }
.map-node { position: absolute; margin: 0; padding: 4px 2px; border-radius: 9px; border-width: 1px; border-color: rgb(55, 72, 67); background-color: rgb(23, 37, 37); color: rgb(157, 174, 165); align-items: center; justify-content: center; }
.map-node__glyph { width: 24px; height: 24px; margin-bottom: 1px; flex-shrink: 0; }
.map-node__label { font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 0; padding: 0; }
.map-node__state { font-size: 9px; letter-spacing: 0.5px; margin-top: 2px; color: var(--ui-muted); }
.map-node.room-elite .map-node__glyph { color: rgb(220, 151, 136); }
.map-node.room-treasure .map-node__glyph { color: var(--ui-gold); }
.map-node.room-rest .map-node__glyph { color: var(--ui-accent); }
.map-node.room-boss .map-node__glyph { color: rgb(195, 169, 218); }
.map-node:disabled { opacity: 1; }
.map-node.is-available { background-color: rgb(45, 68, 49); border-color: var(--ui-accent); border-width: 2px; color: rgb(224, 241, 205); }
.map-node.is-available .map-node__state { color: var(--ui-accent); }
.map-node.is-available:hover { background-color: rgb(65, 88, 57); }
.map-node.is-available:focus { border-color: white; }
.map-node.is-current { background-color: rgb(61, 53, 35); border-color: var(--ui-gold); border-width: 2px; color: rgb(246, 226, 175); }
.map-node.is-current .map-node__state { color: var(--ui-gold); }
.map-node.is-visited { border-color: rgb(113, 101, 69); color: rgb(175, 173, 143); background-color: rgb(32, 37, 32); }
.map-node.is-locked .map-node__glyph { opacity: 0.65; }
.is-mobile .map-dialog { width: 100%; padding: 12px; }
.is-mobile .map-header .dialog-title { font-size: 24px; margin-top: 4px; }
.is-mobile .map-description { font-size: 12px; margin-bottom: 10px; }
.is-mobile .map-footer { padding-top: 8px; }
.is-mobile .map-key { margin-right: 9px; font-size: 9px; }
.is-mobile.is-landscape .map-dialog { padding: 8px 12px; }
.is-mobile.is-landscape .map-header .dialog-title { font-size: 22px; margin: 0; }
.is-mobile.is-landscape .map-header .eyebrow { display: none; }
.is-mobile.is-landscape .map-description { font-size: 11px; margin-bottom: 5px; }
.is-mobile.is-landscape .map-footer { padding-top: 4px; }
