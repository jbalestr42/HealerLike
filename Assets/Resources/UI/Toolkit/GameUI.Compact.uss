#hud-root.compact-hud .top-bar {
    min-height: 44px; height: 44px; flex-direction: row; padding: 0; border-width: 0;
    background-color: transparent; flex-shrink: 0;
}
#hud-root.compact-hud #wave-label {
    font-size: 14px; -unity-font-style: bold; white-space: nowrap; color: rgb(248, 247, 223);
    -unity-text-outline-width: 0; text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9); -unity-text-outline-color: rgb(15, 42, 37);
}
#hud-root.compact-hud #currency-label {
    font-size: 14px; margin-left: 10px; margin-right: 2px; color: rgb(248, 247, 223);
    -unity-text-outline-width: 0; text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9); -unity-text-outline-color: rgb(15, 42, 37);
}
#hud-root.compact-hud .hud-icon {
    min-width: 44px; width: 44px; min-height: 44px; padding: 0; margin: 0;
    background-color: transparent; border-width: 0; border-radius: 22px;
    font-size: 14px; color: rgb(248, 247, 223); justify-content: center; align-items: center;
}
#hud-root.compact-hud .main-content {
    min-height: 0; margin: 0; flex-direction: column; flex-grow: 1;
}
#hud-root.compact-hud .world-space { min-width: 0; min-height: 0; flex-grow: 1; }
/* The encounter buttons centered over the field */
#hud-root.compact-hud .field-toolbar {
    height: 44px; min-height: 44px; margin: 0; flex-shrink: 0; align-items: center;
    flex-direction: column;
}
#hud-root.compact-hud .command-section {
    width: auto; margin: 0; height: 44px;
}
#hud-root.compact-hud .encounter-actions { flex-direction: row; }
#hud-root.compact-hud .encounter-actions .button {
    flex-grow: 0; min-height: 44px; padding: 4px 20px; font-size: 13px; -unity-font-style: normal;
    background-color: rgba(24, 65, 55, 0.48); color: rgb(248, 247, 223);
    border-color: rgba(238, 239, 217, 0.65); border-width: 1px; border-radius: 16px;
}
#hud-root.compact-hud .party-panel {
    position: relative; left: auto; top: auto; bottom: auto; right: auto;
    width: auto; height: 76px; min-height: 76px; max-height: 76px; padding: 0;
    flex-shrink: 0; display: flex; background-color: transparent; border-width: 0;
}
#hud-root.compact-hud .command-dock {
    min-height: 96px; height: 96px; max-height: 96px; padding: 0; margin: 0;
    flex-direction: column; flex-shrink: 0; background-color: transparent; border-width: 0;
}
#hud-root.compact-hud .spell-section {
    flex-direction: column; align-items: stretch; min-width: 0; height: 96px;
}
/* The mana gauge at the top of the screen, its value over the fill, the Devotion beside it */
#hud-root.compact-hud .resource-bar {
    flex-direction: row; justify-content: center; align-items: center; height: 32px; min-height: 32px;
    margin: 0; padding: 0; flex-shrink: 0;
}
#hud-root.compact-hud.is-menu .resource-bar { display: none; }
#hud-root.compact-hud #mana-gauge {
    width: 180px; max-width: 60%; height: 18px; min-height: 18px; flex-shrink: 1;
    margin: 0; overflow: hidden; border-radius: 6px; border-width: 1px;
    border-color: rgba(205, 231, 228, 0.45); background-color: rgba(22, 48, 52, 0.35);
}
#hud-root.compact-hud #mana-fill { height: 100%; flex-shrink: 0; background-color: rgba(85, 166, 178, 0.7); }
#hud-root.compact-hud #mana-value {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%; min-width: 0; padding: 0; margin: 0;
    font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(248, 247, 223);
    -unity-text-outline-width: 0; text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9); -unity-text-outline-color: rgb(15, 42, 37);
}
#hud-root.compact-hud .detail-panel {
    display: flex; position: absolute; width: 280px; max-width: 90%; height: auto;
    max-height: 80%; left: 12px; top: 90px; bottom: auto; right: auto;
    padding: 10px; background-color: var(--ui-card); border-color: var(--ui-ink);
    border-width: 1px; border-radius: 12px;
}
#hud-root.compact-hud .detail-panel.is-hidden { display: none; }
/* Coiny with its descender sign fixed, as on the start screens: with the shipped face a description that wraps to a
   third line is drawn into the second and clipped by the popover. Scoped to the two text panels, the party and spell
   cards keep the original face their heights were tuned for. */
#hud-root.compact-hud .detail-panel,
#hud-root.compact-hud #event-panel {
    -unity-font-definition: url("../../../Render/Font/Coiny/Coiny-Regular-UI.ttf");
}
#hud-root.compact-hud .detail-close {
    position: absolute; right: 0; top: 0; width: 44px; height: 44px; min-height: 44px;
    padding: 0; margin: 0; background-color: transparent; border-width: 0; font-size: 24px;
}
#hud-root.compact-hud .detail-summary { flex-direction: row; }
#hud-root.compact-hud .detail-title { padding: 0 24px 0 0; margin: 0 0 4px 0; font-size: 16px; }
#hud-root.compact-hud .detail-description { font-size: 13px; white-space: normal; color: var(--ui-ink); margin: 0; padding: 0; }
#hud-root.compact-hud .detail-icon { display: flex; width: 40px; height: 40px; margin: 0 8px 0 0; }
#hud-root.compact-hud .detail-copy { flex-shrink: 1; flex-grow: 1; min-width: 0; }
#hud-root.compact-hud .detail-scroll { min-height: 0; flex-shrink: 1; }
#hud-root.compact-hud .detail-actions { margin-top: 4px; }
#hud-root.compact-hud .detail-actions .button { min-height: 44px; margin: 4px 0 0 0; }
#hud-root.compact-hud .pause-settings { flex-direction: column; align-items: stretch; }
#hud-root.compact-hud .pause-settings .speed-controls { width: auto; }
#hud-root.compact-hud .pause-settings .marker-toggle { margin: 0; }
#hud-root.compact-hud .pause-settings #focus-button { min-height: 44px; }
#hud-root.compact-hud .is-hidden { display: none; }
#hud-root.compact-hud.is-menu .party-panel { display: none; }
#hud-root.compact-hud.is-menu .command-dock { display: none; }

#hud-root.compact-hud.is-menu .field-toolbar { display: flex; }

#hud-root.compact-hud #spell-list { width: 100%; height: 94px; flex-grow: 0; flex-shrink: 0; }

#hud-root.compact-hud .hud-icon-surface {
    width: 28px; height: 28px; border-radius: 14px;
    background-color: rgba(12, 47, 44, 0.12); justify-content: center; align-items: center;
}
#hud-root.compact-hud .detail-icon.creature-portrait { background-color: transparent; border-width: 0; border-radius: 0; }
#hud-root.compact-hud .detail-targeting {
    flex-direction: row; align-items: center; min-height: 44px; margin: 4px 0 0 0;
}
#hud-root.compact-hud .detail-targeting > .unity-base-field__label {
    width: 90px; min-width: 0; margin: 0 4px 0 0; font-size: 12px;
}
#hud-root.compact-hud .detail-targeting > .unity-base-field__input { min-width: 0; flex-grow: 1; }
#hud-root.compact-hud .detail-attributes { margin-top: 4px; margin-left: 0; }
#hud-root.compact-hud .detail-attributes > .unity-foldout__toggle { min-height: 46px; font-size: 12px; }
#hud-root.compact-hud .detail-attributes .unity-toggle__text { color: var(--ui-ink); }
#hud-root.compact-hud .detail-attributes .unity-toggle__checkmark { -unity-background-image-tint-color: var(--ui-ink); }
/* A thin bar beside the text, starting under the close button that sits over the panel's top right corner */
#hud-root.compact-hud .detail-scroll .unity-scroller--vertical {
    min-width: 6px; width: 6px; max-width: 6px; margin: 34px 0 0 4px;
}
#hud-root.compact-hud .detail-scroll .unity-base-slider__dragger { min-width: 6px; width: 6px; left: 0; margin: 0; }

/* The ascension level beside the room and the Devotion beside the mana, each opening its details in the popover */
#hud-root.compact-hud .hud-chip {
    margin-left: 8px; padding: 2px 10px; min-height: 28px; flex-shrink: 0;
    font-size: 13px; -unity-font-style: bold; white-space: nowrap; -unity-text-align: middle-center;
    color: rgb(248, 247, 223); background-color: rgba(16, 63, 56, 0.85);
    border-color: rgba(245, 242, 216, 0.65); border-width: 1px; border-radius: 14px;
}
#hud-root.compact-hud .devotion-value { color: rgba(248, 247, 223, 0.55); }
#hud-root.compact-hud .devotion-value.is-lit { color: rgb(255, 214, 102); }
#hud-root.compact-hud.is-mobile .hud-chip { margin-left: 4px; padding: 2px 6px; font-size: 12px; }

/* The healer's items over the top left of the field, each opening its details in the popover */
#hud-root.compact-hud .item-bar {
    position: absolute; left: 0; top: 0; max-width: 70%;
    flex-direction: row; flex-wrap: wrap;
}
#hud-root.compact-hud .item-bar .kit-chip {
    flex-direction: row; align-items: center; margin: 0 4px 4px 0; padding: 3px;
    background-color: rgba(16, 63, 56, 0.7); border-color: rgba(0, 0, 0, 0); border-width: 2px; border-radius: 10px;
}
#hud-root.compact-hud .item-bar .kit-chip__icon {
    width: 30px; height: 30px; border-radius: 8px; -unity-background-scale-mode: scale-to-fit;
}
#hud-root.compact-hud .item-bar .kit-chip__label {
    font-size: 13px; -unity-font-style: bold; color: rgb(248, 247, 223); margin: 0 4px;
}

/* The sandbox tools: a wrapping row of buttons per kind of tool */
#hud-root.compact-hud .sandbox-buttons { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
#hud-root.compact-hud .sandbox-buttons > .button { flex-grow: 0; min-height: 36px; margin: 0 6px 6px 0; padding: 4px 12px; font-size: 13px; }
#hud-root.compact-hud.is-mobile .sandbox-buttons > .button { min-height: 44px; }
#hud-root.compact-hud .sandbox-heading { margin-top: 8px; margin-bottom: 4px; }
