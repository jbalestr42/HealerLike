/* Structure only: spacing, sizing, flex, overflow. Visual art direction lives in Theme. */
.game-ui { flex-grow: 1; padding: 16px; }
.top-bar { flex-direction: row; align-items: center; min-height: 76px; padding: 12px 20px; flex-shrink: 0; }
.brand-block { width: 245px; }
.run-status { flex-grow: 1; }
.header-actions { flex-direction: row; align-items: center; }
.currency { margin-right: 20px; }
.main-content { flex-grow: 1; flex-direction: row; margin-top: 12px; margin-bottom: 12px; min-height: 120px; }
.party-panel { width: 246px; padding: 16px 12px; }
.section-heading { margin-bottom: 6px; }
.section-description { white-space: normal; margin-bottom: 12px; }
.party-list { flex-grow: 1; }
.world-space { flex-grow: 1; min-width: 80px; }
.detail-panel { width: 230px; align-self: flex-start; max-height: 100%; padding: 18px; }
.detail-icon { width: 72px; height: 72px; margin-top: 14px; margin-bottom: 10px; }
.detail-title { white-space: normal; margin-bottom: 8px; }
.detail-description { white-space: normal; }
.detail-scroll { flex-shrink: 1; }
.detail-actions { margin-top: 12px; }
.detail-actions .button { margin-left: 0; margin-top: 6px; }
.detail-targeting { flex-direction: column; align-items: stretch; margin-bottom: 8px; }
.detail-targeting > .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.menu-panel { align-self: center; width: 600px; max-width: 90%; margin-top: 60px; padding: 36px; }
.menu-title { margin-top: 14px; margin-bottom: 18px; white-space: normal; }
.menu-description { white-space: normal; }
.menu-hint { white-space: normal; margin-top: 28px; }
.game-ui.is-menu .command-dock { align-items: flex-end; min-height: 100px; }
.is-menu .command-section { width: 280px; margin-left: 0; }
.inventory-actions { margin-bottom: 16px; }
.inventory-detail { white-space: normal; margin-bottom: 8px; }
.inventory-action-row { flex-direction: row; align-items: center; }
.inventory-target { flex-grow: 1; min-width: 0; }
.inventory-target > .unity-base-field__label { min-width: 64px; }
.inventory-slot { width: 220px; margin-left: 12px; }
.inventory-target, .inventory-slot { flex-direction: column; align-items: stretch; }
.inventory-target > .unity-base-field__label, .inventory-slot > .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.command-dock { flex-direction: row; min-height: 192px; max-height: 240px; flex-shrink: 0; padding: 16px; }
.spell-section { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.section-toolbar { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.mana-bar { width: 210px; height: 18px; }
.spell-list { flex-grow: 1; }
.spell-list .unity-scroll-view__content-container { flex-direction: row; }
.command-section { width: 224px; margin-left: 20px; justify-content: center; }
.status-label { white-space: normal; margin-bottom: 8px; }
.speed-controls { flex-direction: row; align-items: center; margin-top: 8px; }
.speed-controls .eyebrow { flex-grow: 1; }
.marker-toggle { margin-top: 8px; }
.button { min-height: 36px; margin: 0 0 0 6px; padding: 6px 14px; }
.command-section > .button, .dialog--compact > .button { margin-left: 0; }
.button--small { min-width: 40px; min-height: 28px; padding: 3px 6px; }
.data-card { flex-direction: column; flex-shrink: 0; padding: 12px; margin: 0 0 8px 0; min-height: 76px; align-items: flex-start; white-space: normal; }
.data-card__icon { width: 48px; height: 48px; flex-shrink: 0; margin-bottom: 8px; }
.data-card__icon.creature-portrait { width: 80px; height: 80px; }
.detail-icon.creature-portrait { width: 128px; height: 128px; flex-shrink: 0; }
.data-card__title { white-space: normal; margin-bottom: 4px; }
.data-card__description { white-space: normal; }
.data-card__status { white-space: normal; margin-top: 6px; }
.spell-list .data-card { width: 156px; min-height: 118px; margin-right: 8px; margin-bottom: 2px; }
.spell-list .data-card__icon { width: 36px; height: 36px; margin-bottom: 4px; }
.spell-list .data-card__description { display: none; }
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; padding: 32px; }
.dialog { max-width: 100%; max-height: 90%; padding: 28px; }
.dialog--wide { width: 900px; min-height: 340px; }
.dialog--compact { width: 440px; }
.dialog-header { flex-direction: row; justify-content: space-between; align-items: center; }
.dialog-title { white-space: normal; margin-top: 6px; margin-bottom: 10px; }
.dialog-description { white-space: normal; margin-bottom: 20px; }
.collection-list { flex-grow: 1; min-height: 150px; }
.collection-list .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.collection-list .data-card { width: 248px; min-height: 152px; margin-right: 12px; margin-bottom: 12px; }
.health-bar, .cast-bar { width: 100%; height: 8px; margin-top: 6px; }
.is-hidden { display: none; }
/* Runtime can apply is-compact at its panel width breakpoint; no unsupported CSS media queries. */
.game-ui.is-compact { padding: 8px; }
.is-compact .brand-block { width: 172px; }
.is-compact .party-panel { width: 196px; }
.is-compact .detail-panel { width: 190px; }
.is-compact .command-section { width: 190px; margin-left: 12px; }
.is-compact .top-bar { padding: 8px 12px; }
.is-compact .collection-list .data-card { width: 210px; }
.is-compact .menu-panel { margin-top: 24px; padding: 24px; }
.action-button { min-height: 36px; max-width: 100%; white-space: normal; padding: 6px 8px; margin-top: 8px; }
.unity-scroller--vertical { min-width: 10px; max-width: 10px; }
.unity-scroller--horizontal { min-height: 10px; max-height: 10px; }

.field-toolbar { flex-direction: row; flex-shrink: 0; margin-top: 6px; }
.toolbar-space { flex-grow: 1; }
.mobile-only { display: none; }
.drawer-header { flex-direction: row; align-items: center; justify-content: space-between; }
.encounter-actions { flex-direction: row; }
.encounter-actions > .button { flex-grow: 1; margin-left: 0; }
.encounter-actions > #cancel-button { margin-left: 6px; }
.dialog-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.card-shell { position: relative; flex-shrink: 0; margin-bottom: 8px; }
.card-shell > .data-card { width: 100%; margin: 0; }
.card-info { display: none; }
.spell-list .card-shell { width: 156px; margin-right: 8px; margin-bottom: 2px; }
.collection-list .card-shell { width: 248px; margin-right: 12px; margin-bottom: 12px; }
.collection-list .card-shell > .data-card { margin: 0; }
.is-compact .collection-list .card-shell { width: 210px; }
