#hud-root.compact-hud .compact-row { min-width: 0; height: 100%; flex-grow: 1; }
#hud-root.compact-hud .compact-row .unity-scroll-view__content-container { flex-direction: row; }
#hud-root.compact-hud .compact-row .card-shell { width: 84px; height: 94px; margin: 0; flex-shrink: 0; }
#hud-root.compact-hud .party-list .card-shell { width: 72px; height: 76px; }
#hud-root.compact-hud .compact-row .data-card {
    width: 100%; height: 94px; min-height: 44px; margin: 0; padding: 0 2px;
    align-items: center; background-color: transparent; border-width: 0;
    opacity: 1; border-radius: 0;
}
#hud-root.compact-hud .party-list .data-card { height: 76px; }
#hud-root.compact-hud .compact-row .data-card:hover { background-color: rgba(24, 66, 58, 0.15); }
#hud-root.compact-hud .compact-row .data-card:focus { background-color: rgba(24, 66, 58, 0.3); }
#hud-root.compact-hud .compact-row .card-info,
#hud-root.compact-hud .compact-row .data-card__description,
#hud-root.compact-hud .compact-row .data-card__status { display: none; }
#hud-root.compact-hud .compact-row .data-card__icon {
    display: flex; position: relative; left: auto; top: auto; width: 48px; height: 48px;
    margin: 0 0 3px 0; background-color: rgba(15, 72, 66, 0.84);
    border-width: 1px; border-color: rgba(246, 244, 218, 0.8); border-radius: 24px;
}
#hud-root.compact-hud .party-list .data-card__icon {
    width: 52px; height: 52px; margin: 0; background-color: rgba(246, 244, 218, 0.28); border-width: 1px; border-color: rgba(246, 244, 218, 0.7); border-radius: 14px;
}
#hud-root.compact-hud .compact-row .data-card__title {
    font-size: 12px; height: 34px; padding: 0; margin: 0; width: 100%;
    -unity-text-align: upper-center; color: rgb(248, 247, 223); white-space: normal;
    -unity-font-style: bold; -unity-text-outline-width: 0; text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9);
    -unity-text-outline-color: rgb(15, 42, 37);
}
#hud-root.compact-hud .party-list .data-card__title { height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#hud-root.compact-hud .compact-row .spell-cost {
    position: absolute; right: -3px; bottom: -3px; font-size: 12px;
    color: rgb(248, 247, 223); -unity-font-style: bold;
    -unity-text-outline-width: 0; text-shadow: 0 1px 1px rgba(15, 42, 37, 0.9); -unity-text-outline-color: rgb(15, 42, 37);
}
#hud-root.compact-hud .compact-row .mana-shortage .data-card__icon { opacity: 0.4; }
#hud-root.compact-hud .compact-row .mana-shortage .spell-cost { color: rgb(255, 192, 134); }
#hud-root.compact-hud .compact-row .creature-health {
    position: absolute; left: 8px; right: 8px; bottom: 0; height: 2px;
    background-color: rgba(10, 39, 35, 0.8);
}
#hud-root.compact-hud .compact-row .creature-health-fill { height: 2px; background-color: rgb(211, 235, 169); }
