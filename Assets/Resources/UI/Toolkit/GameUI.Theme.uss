/* Art direction only. Replace this sheet to reskin without changing presentation code or hierarchy. */
.game-ui {
    --ui-ink: rgb(229, 235, 228);
    --ui-muted: rgb(151, 173, 165);
    --ui-accent: rgb(189, 218, 156);
    --ui-gold: rgb(233, 202, 135);
    --ui-panel: rgba(16, 29, 30, 0.97);
    --ui-card: rgb(29, 45, 45);
    --ui-border: rgb(65, 88, 81);
    color: var(--ui-ink);
    font-size: 14px;
}
.surface { background-color: var(--ui-panel); border-width: 1px; border-color: var(--ui-border); border-radius: 8px; }
.brand { font-size: 24px; -unity-font-style: bold; color: var(--ui-accent); letter-spacing: 4px; }
.eyebrow { font-size: 10px; -unity-font-style: bold; letter-spacing: 1.8px; color: var(--ui-muted); }
.heading { font-size: 18px; -unity-font-style: bold; color: var(--ui-ink); }
.muted { color: var(--ui-muted); font-size: 12px; }
.currency { color: var(--ui-gold); -unity-font-style: bold; font-size: 16px; }
.button { background-color: var(--ui-card); border-width: 1px; border-color: var(--ui-border); border-radius: 5px; color: var(--ui-ink); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.button:hover { background-color: rgb(44, 65, 58); border-color: var(--ui-accent); }
.button:focus { border-color: var(--ui-gold); border-width: 2px; }
.button:active { background-color: rgb(64, 84, 63); }
.button--primary { background-color: var(--ui-accent); color: rgb(23, 39, 29); border-color: var(--ui-accent); }
.button--primary:hover { background-color: rgb(216, 237, 194); }
.button--quiet { background-color: rgba(0, 0, 0, 0); }
.button:disabled, .data-card:disabled, .is-disabled { opacity: 0.42; }
.data-card { background-color: var(--ui-card); border-width: 1px; border-color: var(--ui-border); border-radius: 6px; color: var(--ui-ink); -unity-text-align: upper-left; }
.data-card:hover { background-color: rgb(39, 58, 53); border-color: var(--ui-accent); }
.data-card:focus, .data-card.is-selected { border-color: var(--ui-gold); border-width: 2px; }
.data-card__icon, .detail-icon { background-color: rgb(12, 24, 26); border-radius: 5px; -unity-background-scale-mode: scale-to-fit; }
.data-card__title { font-size: 14px; -unity-font-style: bold; color: var(--ui-ink); }
.data-card__description { font-size: 11px; color: var(--ui-muted); }
.data-card__status { font-size: 11px; color: var(--ui-gold); }
.is-affordable .data-card__status { color: var(--ui-accent); }
.modal-layer { background-color: rgba(4, 12, 15, 0.78); }
.dialog { border-top-color: var(--ui-accent); border-top-width: 3px; }
.dialog-title { font-size: 30px; -unity-font-style: bold; color: var(--ui-ink); }
.menu-title { font-size: 42px; -unity-font-style: bold; color: var(--ui-accent); }
.menu-description { font-size: 18px; }
.menu-hint { color: var(--ui-gold); font-size: 13px; }
.mana-bar .unity-progress-bar__background { background-color: rgb(14, 27, 36); border-radius: 4px; }
.mana-bar .unity-progress-bar__progress { background-color: rgb(74, 135, 165); border-radius: 4px; }
.mana-bar .unity-progress-bar__title { color: rgb(235, 244, 248); font-size: 11px; }
.health-bar .unity-progress-bar__progress { background-color: rgb(115, 178, 125); }
.cast-bar .unity-progress-bar__progress { background-color: var(--ui-gold); }
.marker-toggle { color: var(--ui-muted); font-size: 11px; }
.unity-scroller--vertical { width: 10px; }
.unity-scroller--horizontal { height: 10px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.action-button { background-color: var(--ui-card); border-width: 1px; border-color: var(--ui-border); border-radius: 5px; color: var(--ui-ink); font-size: 12px; }
.action-button:disabled { opacity: 0.42; }
.unity-scroller .unity-base-slider__tracker { background-color: rgb(16, 29, 30); border-width: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: rgb(65, 88, 81); border-width: 0; border-radius: 4px; }
.unity-base-popup-field__input { background-color: var(--ui-card); border-color: var(--ui-border); color: var(--ui-ink); }
.unity-toggle__input > .unity-toggle__checkmark { background-color: var(--ui-card); border-width: 1px; border-color: var(--ui-border); }
