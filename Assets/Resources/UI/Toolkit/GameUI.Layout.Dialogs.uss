.menu-panel
{
    align-self: center;
    width: var(--ui-menu-width);
    max-width: 90%;
    margin-top: var(--ui-menu-top-gap);
    padding: var(--ui-menu-padding);
}

.menu-title
{
    margin-top: var(--ui-button-inline-padding);
    margin-bottom: var(--ui-detail-padding);
    white-space: normal;
}

.menu-description
{
    white-space: normal;
}

.menu-hint
{
    white-space: normal;
    margin-top: var(--ui-dialog-padding);
}

.inventory-actions
{
    margin-bottom: var(--ui-space-xl);
}

.inventory-detail
{
    white-space: normal;
    margin-bottom: var(--ui-space-md);
}

.inventory-action-row
{
    flex-direction: row;
    align-items: center;
}

.inventory-target
{
    flex-grow: 1;
    min-width: 0;
}

.inventory-target > .unity-base-field__label
{
    min-width: var(--ui-field-label-width);
}

.inventory-slot
{
    width: var(--ui-slot-field-width);
    margin-left: var(--ui-space-lg);
}

.inventory-target,
.inventory-slot
{
    flex-direction: column;
    align-items: stretch;
}

.inventory-target > .unity-base-field__label,
.inventory-slot > .unity-base-field__label
{
    min-width: 0;
    margin-bottom: var(--ui-space-xs);
}

.command-section > .button,
.dialog--compact .dialog-content > .button
{
    margin-left: 0;
}

.modal-layer
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--ui-section-gap);
}

.dialog
{
    max-width: 100%;
    max-height: 90%;
    padding: var(--ui-dialog-padding);
}

.dialog--wide
{
    width: var(--ui-dialog-wide-width);
    min-height: var(--ui-dialog-min-height);
}

.dialog--compact
{
    width: var(--ui-dialog-compact-width);
}

.dialog-header
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.dialog-title
{
    white-space: normal;
    margin-top: var(--ui-space-sm);
    margin-bottom: var(--ui-compact-gap);
}

.dialog-description
{
    white-space: normal;
    margin-bottom: var(--ui-panel-inline-padding);
}

.collection-list
{
    flex-grow: 1;
    min-height: var(--ui-collection-min-height);
}

.collection-list .unity-scroll-view__content-container
{
    flex-direction: row;
    flex-wrap: wrap;
}

.is-compact .menu-panel
{
    margin-top: var(--ui-space-xxl);
    padding: var(--ui-space-xxl);
}

.dialog-body
{
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}
