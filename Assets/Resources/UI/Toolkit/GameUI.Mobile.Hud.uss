.is-mobile .brand-block
{
    display: none;
}

.is-mobile .mobile-only
{
    display: flex;
}

.is-mobile .top-bar
{
    min-height: var(--ui-header-mobile-height);
    padding: var(--ui-space-sm) var(--ui-space-md);
}

.is-mobile .run-status
{
    flex-shrink: 1;
    min-width: 0;
}

.is-mobile .heading
{
    font-size: var(--ui-text-mobile-heading);
}

.is-mobile .run-status .muted
{
    font-size: var(--ui-text-eyebrow);
}

.is-mobile .currency
{
    font-size: var(--ui-text-small);
    margin-right: var(--ui-mobile-currency-gap);
}

.is-mobile .button
{
    min-width: var(--ui-touch-target);
    min-height: var(--ui-touch-target);
    padding: var(--ui-space-sm) var(--ui-compact-gap);
    font-size: var(--ui-text-control);
}

.is-mobile .header-actions .button
{
    margin-left: var(--ui-space-xs);
    padding-left: var(--ui-space-md);
    padding-right: var(--ui-space-md);
}

.is-mobile .field-toolbar
{
    height: var(--ui-touch-target);
    margin-top: var(--ui-space-sm);
}

.is-mobile .field-toolbar > .button
{
    margin-left: 0;
    margin-right: var(--ui-space-sm);
}

.is-mobile .field-toolbar > #focus-button
{
    margin-right: 0;
}

.is-mobile .main-content
{
    min-height: 0;
    margin-top: var(--ui-space-sm);
    margin-bottom: var(--ui-space-sm);
}

.is-mobile .world-space
{
    min-width: 0;
}

.is-mobile .party-panel,
.is-mobile .detail-panel
{
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    width: auto;
    max-height: 100%;
    padding: var(--ui-space-lg);
    display: none;
}

.is-mobile.party-open .party-panel,
.is-mobile.detail-open .detail-panel
{
    display: flex;
}

.is-mobile .detail-panel
{
    align-self: stretch;
}

.is-mobile .drawer-header
{
    flex-shrink: 0;
    margin-bottom: var(--ui-space-md);
}

.is-mobile .drawer-header .section-heading
{
    margin-bottom: 0;
}

.is-mobile .section-description
{
    margin-bottom: var(--ui-space-md);
}

.is-mobile .detail-icon
{
    width: var(--ui-detail-mobile-icon-size);
    height: var(--ui-detail-mobile-icon-size);
    margin-top: 0;
}

.is-mobile .detail-icon.creature-portrait
{
    width: var(--ui-detail-mobile-portrait-size);
    height: var(--ui-detail-mobile-portrait-size);
}

.is-mobile .detail-description
{
    font-size: var(--ui-text-body);
}

.is-mobile .command-dock
{
    min-height: 0;
    max-height: none;
    flex-direction: column;
    padding: var(--ui-space-md);
}

.is-mobile .section-toolbar
{
    margin-bottom: var(--ui-space-xs);
    height: var(--ui-meter-height);
}

.is-mobile .mana-bar
{
    width: var(--ui-mana-mobile-width);
}

.is-mobile .command-section
{
    width: auto;
    margin-left: 0;
    margin-top: var(--ui-space-xs);
}

.is-mobile .status-label
{
    font-size: var(--ui-text-caption);
    margin-bottom: var(--ui-space-xs);
}

.is-mobile .encounter-actions
{
    flex-shrink: 0;
}

.is-mobile .speed-controls
{
    margin-top: 0;
    margin-bottom: var(--ui-space-lg);
}

.is-mobile .speed-controls .button
{
    min-width: var(--ui-speed-touch-width);
}

.is-mobile .marker-toggle
{
    min-height: var(--ui-touch-target);
    align-items: center;
    margin-bottom: var(--ui-space-lg);
    font-size: var(--ui-text-control);
}

.is-mobile .marker-toggle .unity-toggle__input
{
    min-width: var(--ui-touch-target);
    min-height: var(--ui-touch-target);
}

.is-mobile.is-menu .command-dock
{
    min-height: 0;
    align-items: stretch;
}

.is-mobile.is-menu .command-section
{
    width: auto;
    margin-left: 0;
}

.is-mobile.is-menu .field-toolbar
{
    display: none;
}
